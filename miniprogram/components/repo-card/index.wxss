.card {
  position: relative;
  display: flex;
  padding: 27rpx 27rpx 25rpx;
  border-radius: 34rpx;
  border: 1rpx solid var(--border);
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.028), rgba(255, 255, 255, 0) 42%),
    var(--surface);
  margin-bottom: 20rpx;
}

.card.top {
  border-color: rgba(227, 179, 65, 0.28);
  background:
    linear-gradient(180deg, rgba(227, 179, 65, 0.055), rgba(255, 255, 255, 0) 46%),
    var(--surface);
}

.rank {
  flex: 0 0 42rpx;
  width: 42rpx;
  text-align: center;
  padding-top: 4rpx;
  font-size: 38rpx;
  line-height: 1;
  font-weight: 800;
  color: var(--text-faint);
  font-family: "SF Mono", Menlo, Consolas, monospace;
}

.card.top .rank {
  background: linear-gradient(180deg, #ffd479, #e39b2e);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.thumb {
  flex: 0 0 80rpx;
  width: 80rpx;
  height: 80rpx;
  border-radius: 25rpx;
  margin-right: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 800;
  color: #ffffff;
  font-family: "SF Mono", Menlo, Consolas, monospace;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.14);
}

.body {
  flex: 1;
  min-width: 0;
}

.name {
  display: flex;
  align-items: center;
  font-family: "SF Mono", Menlo, Consolas, monospace;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.25;
  white-space: nowrap;
  overflow: hidden;
}

.name .owner {
  color: var(--text-faint);
  font-weight: 500;
  flex: 0 1 auto;
  overflow: hidden;
  text-overflow: ellipsis;
}

.name .repo {
  color: var(--text);
  flex: 0 1 auto;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 榜单位置变化徽章 */
.rk {
  flex: 0 0 auto;
  margin-left: 14rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  line-height: 1.6;
  font-family: -apple-system, "PingFang SC", sans-serif;
}

.rk-new {
  color: #67d98b;
  background: rgba(63, 185, 80, 0.14);
  box-shadow: inset 0 0 0 1rpx rgba(63, 185, 80, 0.3);
}

.rk-up {
  color: var(--green);
  background: rgba(63, 185, 80, 0.1);
}

.rk-down {
  color: var(--text-faint);
  background: var(--surface-2);
}

.purpose {
  margin-top: 11rpx;
  font-size: 25rpx;
  line-height: 1.52;
  color: var(--text);
  opacity: 0.86;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.desc-en {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.45;
  color: var(--text-faint);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.en-tag {
  font-size: 17rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  color: var(--text-faint);
  opacity: 0.75;
  margin-right: 10rpx;
  vertical-align: 1rpx;
}

.meta {
  display: flex;
  align-items: center;
  margin-top: 17rpx;
  font-size: 22rpx;
  color: var(--text-dim);
  white-space: nowrap;
}

.lang {
  display: flex;
  align-items: center;
  flex: 0 0 auto;
  max-width: 190rpx;
  overflow: hidden;
  margin-right: 18rpx;
}

.swatch {
  width: 15rpx;
  height: 15rpx;
  border-radius: 50%;
  margin-right: 10rpx;
  flex: 0 0 15rpx;
}

.star {
  display: flex;
  align-items: center;
  flex: 0 0 auto;
  margin-right: 18rpx;
  font-variant-numeric: tabular-nums;
}

.star-ico {
  font-size: 19rpx;
  opacity: 0.6;
  margin-right: 6rpx;
}

.boost {
  flex: 0 0 auto;
  color: var(--green);
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.bars {
  margin-left: auto;
  display: flex;
  align-items: flex-end;
  height: 40rpx;
}

.bar {
  width: 6rpx;
  border-radius: 3rpx;
  background: var(--surface-3);
  margin-left: 4rpx;
}

.bar.hot {
  background: linear-gradient(180deg, #63d38c, #2f9e63);
}
