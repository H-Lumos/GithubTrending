.seg {
  position: relative;
  display: flex;
  margin: 8rpx 0 26rpx;
  padding: 8rpx;
  border-radius: 26rpx;
  background: var(--surface);
  border: 1rpx solid var(--border);
}

.thumb {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  width: calc((100% - 16rpx) / 3);
  height: calc(100% - 16rpx);
  border-radius: 20rpx;
  background: linear-gradient(180deg, #2b3a52, #223046);
  border: 1rpx solid rgba(120, 170, 255, 0.22);
  box-shadow: 0 12rpx 32rpx -16rpx rgba(0, 80, 200, 0.7);
  transition: transform 0.22s cubic-bezier(0.25, 0.8, 0.3, 1);
}

.theme-light .thumb {
  background: linear-gradient(180deg, #ffffff, #f0f5fb);
  border-color: rgba(9, 105, 218, 0.2);
  box-shadow: 0 10rpx 24rpx -14rpx rgba(9, 105, 218, 0.5);
}

.item {
  position: relative;
  z-index: 1;
  flex: 1;
  text-align: center;
  padding: 19rpx 0;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-dim);
  letter-spacing: 1rpx;
}

.item.on {
  color: var(--text);
}

.theme-light .item.on {
  color: #0b2e57;
}
