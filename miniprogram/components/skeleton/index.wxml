<view class="sk-wrap">
  <!-- 标题区骨架 -->
  <view class="sk-hero">
    <view class="sk" style="width:196rpx;height:26rpx"></view>
    <view class="sk sk-title"></view>
    <view class="sk" style="width:380rpx;height:24rpx;margin-top:22rpx"></view>
  </view>

  <!-- 分段控件骨架 -->
  <view class="sk" style="width:100%;height:86rpx;border-radius:26rpx;margin-bottom:26rpx"></view>

  <!-- 语言 chips 骨架 -->
  <view class="sk-chips">
    <view class="sk" style="width:142rpx;height:60rpx;border-radius:999rpx"></view>
    <view class="sk" style="width:184rpx;height:60rpx;border-radius:999rpx"></view>
    <view class="sk" style="width:154rpx;height:60rpx;border-radius:999rpx"></view>
    <view class="sk" style="width:134rpx;height:60rpx;border-radius:999rpx"></view>
  </view>

  <!-- 卡片骨架 -->
  <view class="sk-card" wx:for="{{list}}" wx:key="*this">
    <view class="sk sk-sq"></view>
    <view class="sk-lines">
      <view class="sk" style="width:52%;height:25rpx"></view>
      <view class="sk" style="width:100%;height:23rpx"></view>
      <view class="sk" style="width:74%;height:23rpx"></view>
      <view class="sk" style="width:44%;height:21rpx;margin-top:4rpx"></view>
    </view>
  </view>
</view>
