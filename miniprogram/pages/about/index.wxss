.nav {
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
}

.nav-btn {
  width: 68rpx;
  height: 68rpx;
  border-radius: 22rpx;
  border: 1rpx solid var(--border);
  background: var(--surface);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text);
  font-size: 34rpx;
}

.nav-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-dim);
}

.brand {
  padding: 40rpx 36rpx 50rpx;
}

.brand-logo {
  width: 108rpx;
  height: 108rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 800;
  font-family: "SF Mono", Menlo, Consolas, monospace;
  color: #07121f;
  background: linear-gradient(160deg, #9fcbff, #4f9cf9);
  box-shadow: 0 24rpx 50rpx -26rpx rgba(79, 156, 249, 0.9);
}

.brand-name {
  margin-top: 28rpx;
  font-size: 46rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
}

.brand-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--text-faint);
}

.group {
  margin: 0 36rpx 26rpx;
  border-radius: 34rpx;
  overflow: hidden;
  background: var(--surface);
  border: 1rpx solid var(--border);
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 30rpx;
  border-bottom: 1rpx solid var(--border);
}

.row:last-child {
  border-bottom: none;
}

.row-k {
  font-size: 26rpx;
  color: var(--text);
}

.row-v {
  font-size: 24rpx;
  color: var(--text-dim);
  max-width: 420rpx;
  text-align: right;
}

.note {
  margin: 0 36rpx 26rpx;
  padding: 32rpx;
  border-radius: 34rpx;
  background: var(--surface);
  border: 1rpx solid var(--border);
}

.note-title {
  font-size: 26rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.note-body {
  font-size: 24rpx;
  line-height: 1.78;
  color: var(--text-dim);
}

.footer {
  padding: 40rpx 0 80rpx;
  text-align: center;
  font-size: 21rpx;
  color: var(--text-faint);
}
