/* 下拉刷新指示器（自定义样式，默认样式已关闭） */
.refresher {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0 4rpx;
  font-size: 22rpx;
  color: var(--text-faint);
}

.refresher-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 14rpx;
  background: var(--accent);
  animation: pulse 0.9s ease-in-out infinite;
}

@keyframes pulse {
  0%,
  100% {
    opacity: 0.25;
    transform: scale(0.8);
  }
  50% {
    opacity: 1;
    transform: scale(1.1);
  }
}

/* 顶部标题与 iOS 状态栏的安全留白已在 inline style 里处理 */
.hero {
  padding-top: 20rpx;
}

/* 右上角两个圆形操作按钮 */
.hero-actions {
  display: flex;
  align-items: center;
}

.hero-actions .icon-btn {
  position: relative;
  margin-left: 14rpx;
}

.ico-star {
  font-size: 32rpx;
  line-height: 1;
}

.ico-badge {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 7rpx;
  border-radius: 999rpx;
  background: var(--accent);
  color: #06101c;
  font-size: 18rpx;
  font-weight: 800;
  line-height: 28rpx;
  text-align: center;
}

.footer-warn {
  color: var(--gold, #e3b341);
  opacity: 0.85;
}
