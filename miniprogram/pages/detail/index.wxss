/* ---------- 导航 ---------- */
.nav {
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
}

.nav-btn {
  width: 68rpx;
  height: 68rpx;
  border-radius: 22rpx;
  /* 同 .icon-btn：不描边，避开原生胶囊的视觉竞争 */
  background: rgba(255, 255, 255, 0.07);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text);
  font-size: 34rpx;
}

.theme-light .nav-btn {
  background: rgba(31, 35, 40, 0.06);
}

.nav-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-dim);
}

.loading-hint {
  padding: 120rpx 0;
  text-align: center;
  font-size: 25rpx;
  color: var(--text-faint);
}

/* ---------- Hero ---------- */
.dhero {
  margin: 4rpx 36rpx 30rpx;
  padding: 40rpx 36rpx;
  border-radius: 44rpx;
  border: 1rpx solid rgba(120, 160, 220, 0.16);
  background:
    radial-gradient(400rpx 240rpx at 100% 0%, rgba(110, 150, 255, 0.22), transparent 65%),
    linear-gradient(160deg, #1b2433, #131820 70%);
}

.theme-light .dhero {
  border-color: rgba(9, 105, 218, 0.14);
  background:
    radial-gradient(400rpx 240rpx at 100% 0%, rgba(9, 105, 218, 0.1), transparent 65%),
    linear-gradient(160deg, #ffffff, #f4f8fd 70%);
}

.badge {
  display: inline-block;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #9fc4ff;
  background: rgba(79, 156, 249, 0.12);
  border: 1rpx solid rgba(79, 156, 249, 0.28);
}

.theme-light .badge {
  color: #0969da;
  background: rgba(9, 105, 218, 0.08);
  border-color: rgba(9, 105, 218, 0.2);
}

.dname {
  margin-top: 26rpx;
  font-family: "SF Mono", Menlo, Consolas, monospace;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.3;
  letter-spacing: -1rpx;
  word-break: break-all;
}

.dname .owner {
  color: var(--text-faint);
  font-weight: 500;
}

.dname .repo {
  color: var(--text);
}

.dsub {
  margin-top: 20rpx;
  font-size: 25rpx;
  line-height: 1.62;
  color: var(--text-dim);
}

.dstats {
  display: flex;
  margin-top: 36rpx;
}

.rank-note {
  margin-top: 14rpx;
  font-size: 21rpx;
  color: var(--text-faint);
  letter-spacing: 1rpx;
}

.stat {
  margin-right: 44rpx;
}

.stat .k {
  font-size: 20rpx;
  letter-spacing: 2rpx;
  font-weight: 700;
  color: var(--text-faint);
}

.stat .v {
  margin-top: 10rpx;
  font-size: 38rpx;
  font-weight: 700;
  font-family: "SF Mono", Menlo, Consolas, monospace;
  font-variant-numeric: tabular-nums;
}

.stat .v.up {
  color: var(--green);
}

/* ---------- 面板 ---------- */
.panel {
  margin: 0 36rpx 26rpx;
  padding: 32rpx;
  border-radius: 38rpx;
  background: var(--surface);
  border: 1rpx solid var(--border);
}

.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 26rpx;
}

.panel-title {
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.panel-hint {
  font-size: 22rpx;
  color: var(--text-faint);
}

/* ---------- 图表 ---------- */
.chart-canvas {
  width: 100%;
  height: 220rpx;
  display: block;
}

.axis {
  display: flex;
  justify-content: space-between;
  margin-top: 14rpx;
  font-size: 20rpx;
  color: var(--text-faint);
  font-variant-numeric: tabular-nums;
}

.chart-fallback {
  padding: 40rpx 0;
  text-align: center;
}

.fb-text {
  font-size: 23rpx;
  color: var(--text-faint);
}

/* ---------- 正文 ---------- */
.prose {
  font-size: 26rpx;
  line-height: 1.78;
  color: var(--text);
  opacity: 0.9;
}

.en-block {
  margin-top: 28rpx;
  padding: 24rpx 26rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.028);
  border: 1rpx solid var(--border);
  border-left: 3rpx solid rgba(110, 150, 255, 0.45);
}

.theme-light .en-block {
  background: var(--surface-2);
  border-left-color: rgba(9, 105, 218, 0.4);
}

.en-lbl {
  font-size: 19rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  color: var(--text-faint);
}

.en-text {
  margin-top: 12rpx;
  font-family: "SF Mono", Menlo, Consolas, monospace;
  font-size: 23rpx;
  line-height: 1.65;
  color: var(--text-dim);
}

.tagrow {
  display: flex;
  flex-wrap: wrap;
  margin-top: 26rpx;
}

.tag {
  padding: 10rpx 20rpx;
  margin: 0 14rpx 14rpx 0;
  border-radius: 16rpx;
  font-size: 22rpx;
  color: var(--text-dim);
  background: var(--surface-2);
  border: 1rpx solid var(--border);
}

/* ---------- 操作区 ---------- */
.cta {
  margin: 6rpx 36rpx 0;
  height: 100rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 29rpx;
  font-weight: 700;
  color: #07121f;
  background: linear-gradient(180deg, #8fc4ff, #4f9cf9);
  box-shadow: 0 30rpx 60rpx -34rpx rgba(79, 156, 249, 0.9);
}

.ghost-row {
  display: flex;
  margin: 20rpx 36rpx 0;
}

.ghost {
  flex: 1;
  height: 88rpx;
  margin: 0 8rpx;
  border-radius: 28rpx;
  border: 1rpx solid var(--border);
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-dim);
}

.ghost-btn {
  padding: 0;
  line-height: 1;
}

.ghost-btn::after {
  border: none;
}
